# OpenRouter API key for image generation via Nano Banana (Gemini 2.5 Flash Image)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: identify your app in OpenRouter analytics
OPENROUTER_APP_NAME=party-games-hub
OPENROUTER_APP_URL=http://localhost:3000

# Public site URL — used for QR code join links.
# Change to your real domain when you buy one (e.g. https://partyge.me).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
